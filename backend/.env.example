# ApexRadio AI - Backend Environment Configuration

# Server
PORT=5001
NODE_ENV=development

# Production Frontend Domains (comma-separated if multiple)
FRONTEND_URL=https://apex-radio-xi.vercel.app,http://localhost:5173
CORS_ORIGIN=https://apex-radio-xi.vercel.app

# JWT Authentication
JWT_SECRET=apexradio-ai-hackathon-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# Groq Whisper Speech-to-Text API
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3

# Hugging Face Emotion Detection Model Configuration
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
HF_REQUEST_TIMEOUT_MS=30000
